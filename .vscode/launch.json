{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pipeline ALIC1 PE",
      "type": "debugpy",
      "request": "launch",
      "module": "dritimeseriesprocessor",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--sites",
        "alic1",
        "--columns",
        "PE",
        "--periodicity",
        "PT30M",
        "--period",
        "P2D",
        "--network",
        "cosmos"
      ]
    },
    {
      "name": "Pipeline ALIC1 PE 1day",
      "type": "debugpy",
      "request": "launch",
      "module": "dritimeseriesprocessor",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--sites",
        "alic1",
        "--columns",
        "PE",
        "--periodicity",
        "P1D",
        "--period",
        "P2D",
        "--network",
        "cosmos"
      ]
    },
    {
      "name": "Pipeline ALIC1 PRECIP",
      "type": "debugpy",
      "request": "launch",
      "module": "dritimeseriesprocessor",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": "--sites=alic1 --columns=PRECIP --periodicity=PT30M P2D"
    },
    {
      "name": "Pipeline",
      "type": "debugpy",
      "request": "launch",
      "module": "dritimeseriesprocessor",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": "--sites=alic1,bunny --columns=PE,PRECIP --periodicity=PT30M P2D"
    }
  ]
}
